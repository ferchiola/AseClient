<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\common.props">
  </Import>
  <PropertyGroup>
    <Description>.NET data provider for Sybase/SAP ASE (Strong Named). Fork of DataAction/AdoNetCore.AseClient — see README.md and DECISIONS.md.</Description>
    <PackageId>Chiola.AseClient.StrongName</PackageId>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../build/AdoNetCore.AseClient.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\AdoNetCore.AseClient\**\*.cs" Exclude="..\AdoNetCore.AseClient\Properties.cs;..\AdoNetCore.AseClient\obj\**\*.cs" />
  </ItemGroup>
</Project>
