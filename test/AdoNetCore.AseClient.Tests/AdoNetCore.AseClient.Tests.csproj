<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Ver el comentario largo en el csproj de src sobre estos flags. NET_CORE (a diferencia de las
         ENABLE_* del proyecto principal) es un flag propio de este proyecto de tests, ver
         Integration/Connection/CharsetTests.cs — selecciona el comportamiento real de .NET moderno
         (cp850 no viene soportado out-of-the-box sin un EncodingProvider registrado), a diferencia de
         .NET Framework clásico. -->
    <DefineConstants>$(DefineConstants);NET_CORE;ENABLE_SYSTEM_DATA_COMMON_EXTENSIONS;ENABLE_DB_PROVIDERFACTORY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="Moq" Version="4.20.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <!-- Pineado a NUnit 3.x a propósito: NUnit 4 movió CollectionAssert/StringAssert a un namespace
         nuevo (NUnit.Framework.Legacy), lo que hubiera requerido tocar varios archivos de test solo
         para el setup inicial del fork — no vale la pena ahora (ver README: "fork ahora, analizar y
         resolver cosas después"). NUnit 3.14.x compila y corre limpio contra net9.0 tal cual. -->
    <PackageReference Include="NUnit" Version="3.14.*" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.*" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdoNetCore.AseClient\AdoNetCore.AseClient.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="DatabaseLoginDetails.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
